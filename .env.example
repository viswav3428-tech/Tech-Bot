# PostgreSQL connection string (Supabase / local)
# Example: postgresql://postgres:yourpassword@db.xyz.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teachbot

# Optional LLM API Keys for Conversational AI Assistant
# If left blank, TEACHBOT uses its built-in offline NLP & command parser
GEMINI_API_KEY=
OPENAI_API_KEY=
